/**
 * QUẢN LÝ LỚP HỌC THẦY LÊ HOÀNG
 * GOOGLE SHEETS SYNC API — MASTER 3.3 COMPATIBLE SAFE
 * HOC_SINH remains exactly 12 columns.
 * Existing students: UPDATE by id, then identity.
 * New students: INSERT exactly once.
 * Event tabs: safe upsert by record id.
 * GET supports JSONP + legacy action aliases.
 */
const CONFIG=Object.freeze({SPREADSHEET_ID:'174xQ29phs-Or7OOEKOM0IHylFJXg5SsqzOC27x7K3Wg',SCHOOL_YEAR:'2026–2027',CLASS_NAME:'5C',EXPECTED_STUDENTS:42,VERSION:'MASTER-3.3-COMPATIBLE-SAFE',TABS:['HOC_SINH','DIEM_DANH','VI_PHAM','KHEN_THUONG','HOC_TAP','TIEN_BO','NHAN_XET','LINK_HOC_SINH','CAU_HINH','NHAT_KY'],HEADERS:{HOC_SINH:['id','name','gender','birthDate','status','parentName','phone','address','note','shareEnabled','createdAt','updatedAt'],DIEM_DANH:['id','studentId','date','status','note','createdAt','updatedAt'],VI_PHAM:['id','studentId','date','type','level','status','action','note','createdAt','updatedAt'],KHEN_THUONG:['id','studentId','date','type','formType','note','createdAt','updatedAt'],HOC_TAP:['id','studentId','date','subject','result','level','note','createdAt','updatedAt'],TIEN_BO:['id','studentId','date','category','level','score','note','createdAt','updatedAt'],NHAN_XET:['id','studentId','date','subject','content','level','createdAt','updatedAt'],LINK_HOC_SINH:['studentId','studentCode','studentName','studentUrl','enabled','createdAt','updatedAt'],CAU_HINH:['Key','Value','UpdatedAt'],NHAT_KY:['timestamp','action','sheet','recordId','message']}});
function getSpreadsheet_(){return SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID)}
function text_(v){return String(v??'').trim().replace(/\s+/g,' ')}
function key_(v){return text_(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLowerCase().replace(/[^a-z0-9]/g,'')}
function dateKey_(v){if(v instanceof Date&&!isNaN(v.getTime()))return Utilities.formatDate(v,Session.getScriptTimeZone()||'Asia/Ho_Chi_Minh','ddMMyyyy');const s=text_(v);if(!s)return'';const iso=s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);if(iso)return iso[3].padStart(2,'0')+iso[2].padStart(2,'0')+iso[1];const dmy=s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})/);if(dmy)return dmy[1].padStart(2,'0')+dmy[2].padStart(2,'0')+dmy[3];return s.replace(/\D/g,'')}
function identityKey_(s){return key_(s.name)+'|'+dateKey_(s.birthDate)+'|'+key_(s.gender)}
function isCanonicalId_(id){return /^STU_5C_2026_\d{3,4}$/i.test(text_(id))}
function preferred_(a,b){if(!a)return b;if(!b)return a;if(isCanonicalId_(b.id)&&!isCanonicalId_(a.id))return b;if(isCanonicalId_(a.id)&&!isCanonicalId_(b.id))return a;return Number(a.row||999999)<=Number(b.row||999999)?a:b}
function json_(obj,e){const cb=String(e&&e.parameter&&e.parameter.callback||'').trim(),body=JSON.stringify(obj);if(cb&&/^[A-Za-z_$][\w$\.]*$/.test(cb))return ContentService.createTextOutput(cb+'('+body+');').setMimeType(ContentService.MimeType.JAVASCRIPT);return ContentService.createTextOutput(body).setMimeType(ContentService.MimeType.JSON)}
function log_(action,sheet,recordId,message){try{const ss=getSpreadsheet_(),sh=ss.getSheetByName('NHAT_KY')||ss.insertSheet('NHAT_KY');if(sh.getLastRow()<1)sh.getRange(1,1,1,5).setValues([CONFIG.HEADERS.NHAT_KY]);sh.appendRow([new Date(),action,sheet,recordId,message])}catch(_) {}}
function ensureTab_(ss,name){let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);const h=CONFIG.HEADERS[name]||[];if(h.length){if(sh.getMaxColumns()<h.length)sh.insertColumnsAfter(sh.getMaxColumns(),h.length-sh.getMaxColumns());const first=sh.getRange(1,1,1,h.length).getValues()[0];if(!first.some(v=>text_(v)))sh.getRange(1,1,1,h.length).setValues([h]);sh.setFrozenRows(1)}return sh}
function setupSheet(){const ss=getSpreadsheet_();CONFIG.TABS.forEach(n=>ensureTab_(ss,n));const sh=ensureTab_(ss,'CAU_HINH'),now=new Date();if(sh.getLastRow()>1)sh.getRange(2,1,sh.getLastRow()-1,3).clearContent();sh.getRange(1,1,1,3).setValues([CONFIG.HEADERS.CAU_HINH]);sh.getRange(2,1,6,3).setValues([['SPREADSHEET_ID',CONFIG.SPREADSHEET_ID,now],['LOP',CONFIG.CLASS_NAME,now],['NAM_HOC',CONFIG.SCHOOL_YEAR,now],['SYNC_VERSION',CONFIG.VERSION,now],['EXPECTED_STUDENTS',CONFIG.EXPECTED_STUDENTS,now],['IDENTITY_MATCH','name+birthDate+gender',now]]);return'OK'}
function headerOk_(sh,name){const h=CONFIG.HEADERS[name];if(!h)return false;if(sh.getMaxColumns()<h.length)return false;const a=sh.getRange(1,1,1,h.length).getValues()[0].map(text_);return h.every((x,i)=>a[i]===x)}
function readPhysicalStudents_(){const sh=getSpreadsheet_().getSheetByName('HOC_SINH');if(!sh)throw new Error('Không tìm thấy SHEET HOC_SINH.');if(!headerOk_(sh,'HOC_SINH'))throw new Error('Header HOC_SINH không đúng schema. API không tự sửa.');const last=sh.getLastRow();if(last<2)return[];const h=CONFIG.HEADERS.HOC_SINH,w=h.length,values=sh.getRange(2,1,last-1,w).getValues();return values.map((r,i)=>{const s={};h.forEach((k,j)=>s[k]=r[j]);s.id=text_(s.id);s.name=text_(s.name);s.gender=text_(s.gender);s.status=text_(s.status)||'active';s.parentName=text_(s.parentName);s.phone=text_(s.phone);s.address=text_(s.address);s.note=text_(s.note);s.shareEnabled=s.shareEnabled===false||String(s.shareEnabled).toUpperCase()==='FALSE'?false:true;s.row=i+2;return s}).filter(s=>s.id&&s.name)}
function dedupeLogicalStudents_(physical){const byIdentity=new Map(),duplicates=[];physical.forEach(s=>{const k=identityKey_(s);if(!k||k==='||')return;const current=byIdentity.get(k);if(!current){byIdentity.set(k,s);return}const keep=preferred_(current,s),drop=keep===current?s:current;byIdentity.set(k,keep);duplicates.push({identity:k,keptId:keep.id,droppedId:drop.id,keptRow:keep.row,droppedRow:drop.row,name:keep.name})});const logical=Array.from(byIdentity.values()).sort((a,b)=>key_(a.name).localeCompare(key_(b.name),'vi')||Number(a.row)-Number(b.row));return{logical,duplicates}}
function readStudents_(){const physical=readPhysicalStudents_(),d=dedupeLogicalStudents_(physical);return{ok:true,count:d.logical.length,physicalCount:physical.length,duplicateCount:d.duplicates.length,students:d.logical,duplicates:d.duplicates,source:'HOC_SINH_SAFE_IDENTITY',version:CONFIG.VERSION}}
function findRowById_(physical,id){const wanted=text_(id);return physical.find(s=>s.id===wanted)||null}
function findRowByIdentity_(physical,incoming){const k=identityKey_(incoming);if(k==='||')return null;let best=null;physical.forEach(s=>{if(identityKey_(s)===k)best=preferred_(best,s)});return best}
function normalizeIncoming_(s){return{id:text_(s&&(s.id||s.studentId||s.studentCode)),name:text_(s&&(s.name||s.studentName||s.hoTen)),gender:text_(s&&(s.gender||s.gioiTinh)),birthDate:s&&(s.birthDate||s.dateOfBirth||s.ngaySinh)||'',status:text_(s&&s.status)||'active',parentName:text_(s&&(s.parentName||s.phuHuynh)),phone:text_(s&&(s.phone||s.dienThoai)),address:text_(s&&(s.address||s.diaChi)),note:text_(s&&(s.note||s.ghiChu)),shareEnabled:s&&s.shareEnabled===false?false:true,createdAt:s&&s.createdAt||new Date(),updatedAt:new Date()}}
function studentRow_(s){return[s.id,s.name,s.gender,s.birthDate,s.status,s.parentName,s.phone,s.address,s.note,s.shareEnabled,s.createdAt||new Date(),new Date()]}
function updateRow_(sh,row,s){const old=sh.getRange(row,1,1,12).getValues()[0],now=new Date(),out=[s.id||old[0],s.name||old[1],s.gender||old[2],s.birthDate||old[3],s.status||old[4]||'active',s.parentName||old[5],s.phone||old[6],s.address||old[7],s.note||old[8],s.shareEnabled,old[10]||s.createdAt||now,now];sh.getRange(row,1,1,12).setValues([out])}
function insertRow_(sh,s){sh.appendRow(studentRow_(s));return sh.getLastRow()}
function syncStudents_(incoming){if(!Array.isArray(incoming)||!incoming.length)throw new Error('Không có dữ liệu học sinh để đồng bộ.');const sh=getSpreadsheet_().getSheetByName('HOC_SINH');if(!sh)throw new Error('Không tìm thấy HOC_SINH.');if(!headerOk_(sh,'HOC_SINH'))throw new Error('Header HOC_SINH không đúng schema.');const physical=readPhysicalStudents_(),updated=[],created=[],skipped=[],seenIdentity=new Set(),seenStoredIds=new Set();incoming.map(normalizeIncoming_).forEach(s=>{if(!s.id||!s.name){skipped.push({id:s.id,name:s.name,reason:'missing-id-or-name'});return}const target=findRowById_(physical,s.id),identityTarget=target||findRowByIdentity_(physical,s),ik=identityKey_(s);if(target||identityTarget){const finalId=identityTarget.id,requestKey=finalId+'|'+ik;if(seenStoredIds.has(requestKey)){skipped.push({id:s.id,name:s.name,reason:'duplicate-in-request'});return}seenStoredIds.add(requestKey);s.id=finalId;updateRow_(sh,identityTarget.row,s);updated.push({incomingId:s.id,storedId:finalId,row:identityTarget.row,name:s.name,matchedBy:target?'ID':'IDENTITY'});return}if(seenIdentity.has(ik)){skipped.push({id:s.id,name:s.name,reason:'duplicate-in-request-identity'});return}seenIdentity.add(ik);const row=insertRow_(sh,s);physical.push({...s,row});created.push({incomingId:s.id,storedId:s.id,row,name:s.name,matchedBy:'NEW_INSERT'})});SpreadsheetApp.flush();const after=readStudents_();log_('SAFE_UPSERT','HOC_SINH','',`created=${created.length}; updated=${updated.length}; skipped=${skipped.length}; physical=${after.physicalCount}; logical=${after.count}; duplicates=${after.duplicateCount}`);return{ok:true,created:created.length,createdRows:created,deleted:0,updated:updated.length,updatedRows:updated,skipped,physicalCount:after.physicalCount,logicalCount:after.count,duplicateCount:after.duplicateCount,mode:'SAFE_UPSERT_ID_OR_NAME_BIRTHDATE_GENDER',version:CONFIG.VERSION}}
function eventHeaders_(sheet){const h=CONFIG.HEADERS[sheet];if(!h)throw new Error('Sheet không được phép: '+sheet);return h}
function readRecords_(sheet){const sh=getSpreadsheet_().getSheetByName(sheet);if(!sh)return[];if(!headerOk_(sh,sheet))throw new Error('Header '+sheet+' không đúng schema.');const h=eventHeaders_(sheet),last=sh.getLastRow();if(last<2)return[];const values=sh.getRange(2,1,last-1,h.length).getValues();return values.map(r=>{const o={};h.forEach((k,i)=>o[k]=r[i]);return o}).filter(r=>text_(r.id))}
function saveEvent_(sheet,record){const h=eventHeaders_(sheet),sh=ensureTab_(getSpreadsheet_(),sheet),id=text_(record&&record.id);if(!id)throw new Error('Record thiếu id.');if(!headerOk_(sh,sheet))throw new Error('Header '+sheet+' không đúng schema.');const last=sh.getLastRow(),values=last<2?[]:sh.getRange(2,1,last-1,h.length).getValues();let row=-1;for(let i=0;i<values.length;i++){if(text_(values[i][0])===id){row=i+2;break}}const out=h.map(k=>record[k]??'');if(row<0){sh.appendRow(out);row=sh.getLastRow()}else sh.getRange(row,1,1,h.length).setValues([out]);SpreadsheetApp.flush();return{ok:true,stored:true,sheet:sheet,id:id,row:row}}
function getAll_(){const students=readStudents_();return{ok:true,version:CONFIG.VERSION,HOC_SINH:students.students,DIEM_DANH:readRecords_('DIEM_DANH'),VI_PHAM:readRecords_('VI_PHAM'),KHEN_THUONG:readRecords_('KHEN_THUONG'),HOC_TAP:readRecords_('HOC_TAP'),TIEN_BO:readRecords_('TIEN_BO'),NHAN_XET:readRecords_('NHAN_XET'),meta:{studentCount:students.count,physicalStudentCount:students.physicalCount,duplicateStudentCount:students.duplicateCount}}}
function auditDuplicates_(){const r=readStudents_();return{ok:true,physicalCount:r.physicalCount,logicalCount:r.count,duplicateCount:r.duplicateCount,duplicates:r.duplicates,policy:'READ_ONLY_NO_DELETE'}}
function testApi(){const r=getAll_();const out={ok:true,action:'testApi',version:CONFIG.VERSION,schoolYear:CONFIG.SCHOOL_YEAR,className:CONFIG.CLASS_NAME,physicalCount:r.meta.physicalStudentCount,logicalCount:r.meta.studentCount,duplicateCount:r.meta.duplicateStudentCount,attendance:r.DIEM_DANH.length,violations:r.VI_PHAM.length,rewards:r.KHEN_THUONG.length,spreadsheetId:CONFIG.SPREADSHEET_ID,timestamp:new Date().toISOString()};Logger.log(JSON.stringify(out,null,2));return out}
function doGet(e){const action=String((e&&e.parameter&&e.parameter.action)||'ping').trim().toLowerCase();try{if(action==='ping')return json_({ok:true,service:'LE_HOANG_CLASSROOM_SYNC',version:CONFIG.VERSION,policy:'SAFE_IDENTITY_UPSERT_PLUS_EVENT_API'},e);if(action==='setup')return json_({ok:true,message:setupSheet()},e);if(['get_students','getstudents','getstudentslist','students','roster','get_roster'].includes(action))return json_(readStudents_(),e);if(['get_all','all','bootstrap'].includes(action))return json_(getAll_(),e);if(['get_events','events'].includes(action))return json_({ok:true,version:CONFIG.VERSION,DIEM_DANH:readRecords_('DIEM_DANH'),VI_PHAM:readRecords_('VI_PHAM'),KHEN_THUONG:readRecords_('KHEN_THUONG')},e);if(action==='save_event'){const payload=__parseGetSaveEvent_(e);return json_(saveEvent_(payload.sheet,payload.record),e)}if(action==='audit_duplicates')return json_(auditDuplicates_(),e);if(['restore_master_students','repair_students','compact_students'].includes(action))return json_({ok:false,blocked:true,error:'Đã khóa thao tác tự động xóa/dồn/đổi ID để bảo vệ dữ liệu. Dùng audit_duplicates để kiểm tra trước.'},e);return json_({ok:false,error:'Unknown action',supportedActions:['ping','get_students','students','roster','get_all','get_events','save_event','audit_duplicates'],version:CONFIG.VERSION},e)}catch(err){log_('ERROR','SYSTEM','',String(err.stack||err));return json_({ok:false,error:String(err.message||err),version:CONFIG.VERSION},e)}}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(30000);const body=parseBody_(e),action=String(body.action||'').trim().toLowerCase();if(action==='sync_students')return json_(syncStudents_(Array.isArray(body.students)?body.students:[]),e);if(action==='save_event'){const record=typeof body.record==='string'?JSON.parse(body.record):body.record;return json_(saveEvent_(text_(body.sheet),record||{}),e)}if(action==='audit_duplicates')return json_(auditDuplicates_(),e);if(action==='setup')return json_({ok:true,message:setupSheet()},e);if(['restore_master_students','repair_students','compact_students'].includes(action))return json_({ok:false,blocked:true,error:'Đã khóa thao tác phục hồi/xóa/dồn/đổi ID.'},e);return json_({ok:false,error:'Unknown action',supportedActions:['sync_students','save_event','audit_duplicates','setup'],version:CONFIG.VERSION},e)}catch(err){log_('ERROR','SYSTEM','',String(err.stack||err));return json_({ok:false,error:String(err.message||err),version:CONFIG.VERSION},e)}finally{try{lock.releaseLock()}catch(_) {}}}
function __parseGetSaveEvent_(e){const p=(e&&e.parameter)||{},sheet=text_(p.sheet);let record=p.record||p.data||'';if(typeof record==='string'){try{record=JSON.parse(record)}catch(_){throw new Error('Record save_event không phải JSON hợp lệ.')}}if(!record||typeof record!=='object')throw new Error('Thiếu record save_event.');return{sheet:sheet,record:record}}
function parseBody_(e){if(!e)return{};if(e.postData&&e.postData.contents){try{return JSON.parse(e.postData.contents)}catch(_) {}}const p=e.parameter||{};if(p.payload){try{return JSON.parse(p.payload)}catch(_) {}}return p}
