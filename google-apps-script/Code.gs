const CONFIG={SPREADSHEET_ID:'1v9H6dReZiC_fCg6T9ISdfWOy1FN1HJQXXrKsABiCLI4',SCHOOL_YEAR:'2026–2027',CLASS_NAME:'5C',EXPECTED_STUDENTS:42,VERSION:'MASTER-7.1-VIETNAMESE-EVENT-DATA',HEADERS:{HOC_SINH:['id','name','gender','birthDate','status','parentName','phone','address','note','shareEnabled','createdAt','updatedAt'],DIEM_DANH:['id','studentName','studentId','date','status','note','createdAt','updatedAt'],VI_PHAM:['id','studentName','studentId','date','type','level','status','action','note','createdAt','updatedAt'],KHEN_THUONG:['id','studentName','studentId','date','type','formType','note','createdAt','updatedAt'],HOC_TAP:['id','studentName','studentId','date','subject','result','level','note','createdAt','updatedAt'],TIEN_BO:['id','studentName','studentId','date','category','level','score','note','createdAt','updatedAt'],NHAN_XET:['id','studentName','studentId','date','subject','content','level','createdAt','updatedAt'],LINK_HOC_SINH:['studentId','studentCode','studentName','studentUrl','enabled','createdAt','updatedAt'],CAU_HINH:['Key','Value','UpdatedAt'],NHAT_KY:['timestamp','action','sheet','recordId','message']}};
const OLD={DIEM_DANH:['id','studentId','date','status','note','createdAt','updatedAt'],VI_PHAM:['id','studentId','date','type','level','status','action','note','createdAt','updatedAt'],KHEN_THUONG:['id','studentId','date','type','formType','note','createdAt','updatedAt'],HOC_TAP:['id','studentId','date','subject','result','level','note','createdAt','updatedAt'],TIEN_BO:['id','studentId','date','category','level','score','note','createdAt','updatedAt'],NHAN_XET:['id','studentId','date','subject','content','level','createdAt','updatedAt']};
function getSpreadsheet_(){return SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID)}
function text_(v){return String(v??'').trim().replace(/\s+/g,' ')}
function json_(o,e){const cb=text_(e?.parameter?.callback),b=JSON.stringify(o);return cb&&/^[A-Za-z_$][\w$\.]*$/.test(cb)?ContentService.createTextOutput(cb+'('+b+');').setMimeType(ContentService.MimeType.JAVASCRIPT):ContentService.createTextOutput(b).setMimeType(ContentService.MimeType.JSON)}
function students_(){const sh=getSpreadsheet_().getSheetByName('HOC_SINH');if(!sh)throw Error('Không tìm thấy HOC_SINH');const h=CONFIG.HEADERS.HOC_SINH,cur=h.map((_,i)=>text_(sh.getRange(1,i+1).getValue()));if(!h.every((x,i)=>cur[i]===x))throw Error('Header HOC_SINH không đúng schema');const n=sh.getLastRow();if(n<2)return[];return sh.getRange(2,1,n-1,h.length).getValues().map(r=>{const o={};h.forEach((k,i)=>o[k]=r[i]);o.id=text_(o.id);o.name=text_(o.name);o.status=text_(o.status)||'active';return o}).filter(x=>x.id&&x.name)}
function migrateEventSheet_(name){const sh=getSpreadsheet_().getSheetByName(name);if(!sh)return;const neu=CONFIG.HEADERS[name],old=OLD[name],cur=neu.map((_,i)=>text_(sh.getRange(1,i+1).getValue()));if(neu.every((x,i)=>cur[i]===x))return;if(!old.every((x,i)=>cur[i]===x))throw Error('Header '+name+' không đúng schema cũ/mới');const last=sh.getLastRow(),rows=last<2?[]:sh.getRange(2,1,last-1,old.length).getValues(),names={};students_().forEach(s=>names[text_(s.id)]=s.name);sh.clearContents();sh.getRange(1,1,1,neu.length).setValues([neu]);if(!rows.length)return;const out=rows.map(row=>{const o={};old.forEach((k,i)=>o[k]=row[i]);o.studentName=names[text_(o.studentId)]||'';return neu.map(k=>o[k]??'')});sh.getRange(2,1,out.length,neu.length).setValues(out)}
function ensure_(name){if(!CONFIG.HEADERS[name])throw Error('Sheet không được phép: '+name);migrateEventSheet_(name);const ss=getSpreadsheet_(),sh=ss.getSheetByName(name)||ss.insertSheet(name),h=CONFIG.HEADERS[name];if(sh.getMaxColumns()<h.length)sh.insertColumnsAfter(sh.getMaxColumns(),h.length-sh.getMaxColumns());const cur=h.map((_,i)=>text_(sh.getRange(1,i+1).getValue()));if(cur.every(v=>!v))sh.getRange(1,1,1,h.length).setValues([h]);if(!h.every((x,i)=>text_(sh.getRange(1,i+1).getValue())===x))throw Error('Header '+name+' không đúng schema');return sh}
const VI={present:'Có mặt',excused:'Có phép',absent:'Không phép','good-deed':'Việc tốt',learning:'Học tập',achievement:'Thành tích',praise:'Tuyên dương',certificate:'Giấy khen',gift:'Phần thưởng',late:'Đi học muộn','late-school':'Đi học muộn',homework:'Chưa hoàn thành bài',behavior:'Hành vi chưa phù hợp',uniform:'Trang phục',other:'Khác',open:'Đang theo dõi',resolved:'Đã xử lý',low:'Nhẹ',medium:'Trung bình',high:'Nặng',reminder:'Nhắc nhở',discussion:'Trao đổi',support:'Hỗ trợ',active:'Đang học',inactive:'Không còn học'};
function vi_(v){const s=text_(v);return VI[s]||s}
function read_(name){const sh=ensure_(name),h=CONFIG.HEADERS[name],n=sh.getLastRow();if(n<2)return[];return sh.getRange(2,1,n-1,h.length).getValues().map(r=>{const o={};h.forEach((k,i)=>o[k]=r[i]);['status','type','level','action','formType','result','category'].forEach(k=>{if(o[k]!==undefined)o[k]=vi_(o[k])});return o}).filter(x=>text_(x.id))}
function save_(sheet,record){const h=CONFIG.HEADERS[sheet],r={...(record||{})},sid=text_(r.studentId);if(!h||!sid)throw Error('Dữ liệu thiếu sheet hoặc studentId');const s=students_().find(x=>text_(x.id)===sid);if(!s)throw Error('studentId không tồn tại: '+sid);r.studentId=sid;r.studentName=text_(r.studentName)||s.name;r.id=text_(r.id)||('EV_'+Date.now()+'_'+Math.random().toString(36).slice(2,8));r.date=text_(r.date)||new Date();const sh=ensure_(sheet),n=sh.getLastRow(),vals=n<2?[]:sh.getRange(2,1,n-1,h.length).getValues();let row=-1;for(let i=0;i<vals.length;i++)if(text_(vals[i][0])===r.id){row=i+2;break}const out=h.map(k=>r[k]??'');if(row<0)sh.appendRow(out);else sh.getRange(row,1,1,h.length).setValues([out]);SpreadsheetApp.flush();return{ok:true,saved:true,stored:true,id:r.id,sheet,row:row<0?sh.getLastRow():row,version:CONFIG.VERSION}}
function del_(sheet,id){sheet=text_(sheet).toUpperCase();if(!['DIEM_DANH','VI_PHAM','KHEN_THUONG','HOC_TAP'].includes(sheet))throw Error('Không được phép xóa '+sheet);const sh=ensure_(sheet),n=sh.getLastRow(),rid=text_(id);if(n<2)throw Error('Không có dữ liệu để xóa');const ids=sh.getRange(2,1,n-1,1).getValues();const i=ids.findIndex(r=>text_(r[0])===rid);if(i<0)throw Error('Không tìm thấy lượt có ID: '+rid+' trong '+sheet);sh.deleteRow(i+2);SpreadsheetApp.flush();return{ok:true,deleted:true,id:rid,sheet,version:CONFIG.VERSION}}
function delAll_(sheet){sheet=text_(sheet).toUpperCase();if(!['VI_PHAM','KHEN_THUONG'].includes(sheet))throw Error('Chỉ xóa tất cả ở VI_PHAM/KHEN_THUONG');const sh=ensure_(sheet),n=Math.max(0,sh.getLastRow()-1);if(n)sh.getRange(2,1,n,CONFIG.HEADERS[sheet].length).clearContent();SpreadsheetApp.flush();return{ok:true,deleted:true,deletedCount:n,sheet,version:CONFIG.VERSION}}
function all_(){return{ok:true,version:CONFIG.VERSION,HOC_SINH:students_(),DIEM_DANH:read_('DIEM_DANH'),VI_PHAM:read_('VI_PHAM'),KHEN_THUONG:read_('KHEN_THUONG'),HOC_TAP:read_('HOC_TAP'),TIEN_BO:read_('TIEN_BO'),NHAN_XET:read_('NHAN_XET')}}
function parse_(v){try{return JSON.parse(v||'{}')}catch(e){throw Error('Payload JSON không hợp lệ')}}
function doGet(e){const a=text_(e?.parameter?.action).toLowerCase()||'ping';try{if(a==='ping')return json_({ok:true,service:'LE_HOANG_CLASSROOM_SYNC',version:CONFIG.VERSION,spreadsheetId:CONFIG.SPREADSHEET_ID,className:CONFIG.CLASS_NAME},e);if(['get_students','students','roster','get_roster'].includes(a))return json_({ok:true,students:students_(),count:students_().length,version:CONFIG.VERSION},e);if(['get_all','all','bootstrap'].includes(a))return json_(all_(),e);if(['get_events','events'].includes(a))return json_({ok:true,version:CONFIG.VERSION,DIEM_DANH:read_('DIEM_DANH'),VI_PHAM:read_('VI_PHAM'),KHEN_THUONG:read_('KHEN_THUONG')},e);if(a==='save_event'){const p=parse_(e.parameter.payload||e.parameter.record);return json_(save_(p.sheet,p.record),e)}if(['delete_event','delete_violation','deleteviolation','remove_violation'].includes(a))return json_(del_(e.parameter.sheet||'VI_PHAM',e.parameter.id||e.parameter.recordId||e.parameter.eventId),e);if(['delete_reward','deletereward','remove_reward'].includes(a))return json_(del_('KHEN_THUONG',e.parameter.id||e.parameter.recordId||e.parameter.eventId),e);if(['delete_all_events','delete_all','clear_events','clear_all_events'].includes(a))return json_(delAll_(e.parameter.sheet),e);return json_({ok:false,error:'Unknown action',version:CONFIG.VERSION},e)}catch(err){return json_({ok:false,error:String(err?.message||err),version:CONFIG.VERSION},e)}}
function doPost(e){try{const p=parse_(e?.postData?.contents||e?.parameter?.payload||'{}'),a=text_(p.action).toLowerCase();if(a==='save_event')return json_(save_(p.sheet,p.record),e);if(['delete_event','delete_violation','deleteviolation','remove_violation'].includes(a))return json_(del_(p.sheet||'VI_PHAM',p.id||p.recordId||p.eventId),e);if(['delete_reward','deletereward','remove_reward'].includes(a))return json_(del_('KHEN_THUONG',p.id||p.recordId||p.eventId),e);if(['delete_all_events','delete_all','clear_events','clear_all_events'].includes(a))return json_(delAll_(p.sheet),e);if(a==='get_events')return json_({ok:true,DIEM_DANH:read_('DIEM_DANH'),VI_PHAM:read_('VI_PHAM'),KHEN_THUONG:read_('KHEN_THUONG')},e);return json_({ok:false,error:'Unknown POST action',version:CONFIG.VERSION},e)}catch(err){return json_({ok:false,error:String(err?.message||err),version:CONFIG.VERSION},e)}}
function migrateAllEventSheets(){['DIEM_DANH','VI_PHAM','KHEN_THUONG','HOC_TAP','TIEN_BO','NHAN_XET'].forEach(migrateEventSheet_);SpreadsheetApp.flush();return{ok:true,version:CONFIG.VERSION,message:'Đã chuyển cột B thành Tên học sinh, cột C thành mã học sinh.'}}
function testApi(){return{ok:true,version:CONFIG.VERSION,spreadsheetId:CONFIG.SPREADSHEET_ID,className:CONFIG.CLASS_NAME,students:students_().length,timestamp:new Date().toISOString()}}