/** LE HOANG CLASSROOM SYNC — MASTER 4.4 AUTO BOOTSTRAP ON CONNECTION */
const CONFIG=Object.freeze({SPREADSHEET_ID:'1v9H6dReZiC_fCg6T9ISdfWOy1FN1HJQXXrKsABiCLI4',SCHOOL_YEAR:'2026–2027',CLASS_NAME:'5C',EXPECTED_STUDENTS:42,VERSION:'MASTER-4.4-AUTO-BOOTSTRAP-ON-CONNECTION',ROSTER_URL:'https://raw.githubusercontent.com/levanhoangtsth1977-crypto/Quan_li_lop_hoc_thay_le_hoang/master/DANH_SACH_HOC_SINH_5C_2026_2027.json',HEADERS:{HOC_SINH:['id','name','gender','birthDate','status','parentName','phone','address','note','shareEnabled','createdAt','updatedAt'],NHAT_KY:['timestamp','action','sheet','recordId','message'],DIEM_DANH:['id','studentId','date','status','note','createdAt','updatedAt'],VI_PHAM:['id','studentId','date','type','level','status','action','note','createdAt','updatedAt'],KHEN_THUONG:['id','studentId','date','type','formType','note','createdAt','updatedAt']}});
function getSpreadsheet_(){return SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID)}
function text_(v){return String(v==null?'':v).trim().replace(/\s+/g,' ')}
function key_(v){return text_(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLowerCase().replace(/[^a-z0-9]/g,'')}
function dateKey_(v){if(v instanceof Date&&!isNaN(v))return Utilities.formatDate(v,Session.getScriptTimeZone()||'Asia/Ho_Chi_Minh','ddMMyyyy');const s=text_(v),m=s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})/);return m?m[1].padStart(2,'0')+m[2].padStart(2,'0')+m[3]:s.replace(/\D/g,'')}
function identity_(s){return key_(s.name)+'|'+dateKey_(s.birthDate)+'|'+key_(s.gender)}
function json_(o,e){const cb=text_(e&&e.parameter&&e.parameter.callback),b=JSON.stringify(o);return cb&&/^[A-Za-z_$][\w$\.]*$/.test(cb)?ContentService.createTextOutput(cb+'('+b+');').setMimeType(ContentService.MimeType.JAVASCRIPT):ContentService.createTextOutput(b).setMimeType(ContentService.MimeType.JSON)}
function headerOk_(sh){const h=CONFIG.HEADERS.HOC_SINH;if(sh.getMaxColumns()<12)return false;const a=sh.getRange(1,1,1,12).getValues()[0].map(text_);return h.every((x,i)=>a[i]===x)}
function sheet_(){const sh=getSpreadsheet_().getSheetByName('HOC_SINH');if(!sh)throw Error('Không tìm thấy HOC_SINH.');if(!headerOk_(sh))throw Error('Header HOC_SINH không đúng 12 cột.');return sh}
function read_(){const sh=sheet_(),n=sh.getLastRow();if(n<2)return[];return sh.getRange(2,1,n-1,12).getValues().map((r,i)=>({id:text_(r[0]),name:text_(r[1]),gender:text_(r[2]),birthDate:r[3],status:text_(r[4])||'active',parentName:text_(r[5]),phone:text_(r[6]),address:text_(r[7]),note:text_(r[8]),shareEnabled:String(r[9]).toUpperCase()!=='FALSE',createdAt:r[10],updatedAt:r[11],row:i+2})).filter(s=>s.id&&s.name)}
function log_(a,m){try{const ss=getSpreadsheet_(),sh=ss.getSheetByName('NHAT_KY')||ss.insertSheet('NHAT_KY');if(sh.getLastRow()<1)sh.getRange(1,1,1,5).setValues([CONFIG.HEADERS.NHAT_KY]);sh.appendRow([new Date(),a,'','',m])}catch(_) {}}
function normalize_(s,i){return{id:text_(s.id)||('STU_5C_2026_'+String(i+1).padStart(3,'0')),name:text_(s.name||s.studentName),gender:text_(s.gender),birthDate:s.birthDate||'',status:text_(s.status)||'active',parentName:text_(s.parentName),phone:text_(s.phone),address:text_(s.address),note:text_(s.note),shareEnabled:s.shareEnabled!==false,createdAt:s.createdAt||new Date(),updatedAt:new Date()}}
function dedupe_(a){const m=new Map();(a||[]).map((s,i)=>normalize_(s,i)).filter(s=>s.name).forEach(s=>{const k=identity_(s);if(!m.has(k))m.set(k,s)});return Array.from(m.values())}
function readStudents_(){const p=read_(),m=new Map(),dups=[];p.forEach(s=>{const k=identity_(s);if(!m.has(k))m.set(k,s);else dups.push({keptId:m.get(k).id,droppedId:s.id,name:s.name})});const students=Array.from(m.values()).sort((a,b)=>key_(a.name).localeCompare(key_(b.name),'vi'));return{ok:true,count:students.length,physicalCount:p.length,logicalCount:students.length,duplicateCount:dups.length,students,duplicates:dups,source:'HOC_SINH_SAFE_IDENTITY',version:CONFIG.VERSION}}
function restoreMasterStudents_(){const sh=sheet_();const existing=read_();if(existing.length>0)return{ok:true,restored:false,count:existing.length,reason:'HOC_SINH_NOT_EMPTY'};const res=UrlFetchApp.fetch(CONFIG.ROSTER_URL,{muteHttpExceptions:true});if(res.getResponseCode()!==200)throw Error('Không đọc được danh sách MASTER trên GitHub: HTTP '+res.getResponseCode());const src=JSON.parse(res.getContentText());const students=dedupe_(src.students||[]);if(students.length!==CONFIG.EXPECTED_STUDENTS)throw Error('Danh sách MASTER không đủ 42 học sinh: '+students.length);const rows=students.map(s=>[s.id,s.name,s.gender,s.birthDate,s.status,s.parentName,s.phone,s.address,s.note,s.shareEnabled,s.createdAt,s.updatedAt]);if(sh.getMaxRows()<rows.length+1)sh.insertRowsAfter(sh.getMaxRows(),rows.length+1-sh.getMaxRows());sh.getRange(2,1,rows.length,12).setValues(rows);SpreadsheetApp.flush();log_('MASTER_ROSTER_RECOVERY','Khôi phục '+rows.length+' học sinh từ GitHub, giữ nguyên 12 cột');return{ok:true,restored:true,count:rows.length,physicalCount:rows.length,source:'GITHUB_MASTER_ROSTER',version:CONFIG.VERSION}}
function eventConfig_(tab){if(!CONFIG.HEADERS[tab])throw Error('Tab sự kiện không hợp lệ: '+tab);return CONFIG.HEADERS[tab]}
function eventSheet_(tab){const ss=getSpreadsheet_(),sh=ss.getSheetByName(tab)||ss.insertSheet(tab),h=eventConfig_(tab);if(sh.getLastRow()<1||sh.getRange(1,1,1,h.length).getValues()[0].map(text_).join('|')!==h.join('|'))sh.getRange(1,1,1,h.length).setValues([h]);return sh}
function eventNormalize_(tab,r){const h=eventConfig_(tab),o={};h.forEach((k,i)=>o[k]=r&&r[k]!==undefined?r[k]:'');o.id=text_(o.id)||('REC_'+tab+'_'+Utilities.getUuid().replace(/-/g,''));o.studentId=text_(o.studentId);o.date=text_(o.date);o.createdAt=o.createdAt||new Date();o.updatedAt=new Date();return o}
function eventRead_(tab){const sh=eventSheet_(tab),h=eventConfig_(tab),n=sh.getLastRow();if(n<2)return[];const rows=sh.getRange(2,1,n-1,h.length).getValues();return rows.map(r=>{const o={};h.forEach((k,i)=>o[k]=r[i]);return o}).filter(o=>text_(o.id)&&text_(o.studentId)).filter(o=>tab!=='DIEM_DANH'||!/^present$/i.test(text_(o.status)))}
function purgePresentAttendance_(sh,h){const statusIndex=h.indexOf('status');if(statusIndex<0||sh.getLastRow()<2)return 0;const values=sh.getRange(2,1,sh.getLastRow()-1,h.length).getValues(),rows=[];values.forEach((r,i)=>{if(/^present$/i.test(text_(r[statusIndex])))rows.push(i+2)});rows.reverse().forEach(row=>sh.deleteRow(row));return rows.length}
function syncEvents_(payload){const tabs=['DIEM_DANH','VI_PHAM','KHEN_THUONG'];const requested=payload&&payload.records&&typeof payload.records==='object'?payload.records:{};const result={ok:true,version:CONFIG.VERSION};tabs.forEach(tab=>{const incoming=Array.isArray(requested[tab])?requested[tab]:[];const sh=eventSheet_(tab),h=eventConfig_(tab);let removed=0;if(tab==='DIEM_DANH')removed+=purgePresentAttendance_(sh,h);let last=sh.getLastRow();let existing=last<2?[]:sh.getRange(2,1,last-1,h.length).getValues();const idIndex=h.indexOf('id');const studentIndex=h.indexOf('studentId');const incomingObjs=incoming.map(r=>eventNormalize_(tab,r)).filter(o=>text_(o.studentId)&&!(tab==='DIEM_DANH'&&/^present$/i.test(text_(o.status))));const incomingIds=new Set(incomingObjs.map(o=>text_(o.id)).filter(Boolean));const rowsToDelete=[];existing.forEach((row,i)=>{const id=text_(row[idIndex]);if(!id||!incomingIds.has(id))rowsToDelete.push(i+2)});rowsToDelete.reverse().forEach(row=>{sh.deleteRow(row);removed++});last=sh.getLastRow();existing=last<2?[]:sh.getRange(2,1,last-1,h.length).getValues();const byId=new Map(),byStudentDate=new Map();existing.forEach((row,i)=>{const id=text_(row[idIndex]);if(id)byId.set(id,{row:i+2});if(tab==='DIEM_DANH')byStudentDate.set(text_(row[studentIndex])+'|'+text_(row[h.indexOf('date')]),{row:i+2})});let created=0,updated=0;incomingObjs.forEach(o=>{if(tab==='DIEM_DANH'){const oldDate=byStudentDate.get(o.studentId+'|'+o.date);if(oldDate&&!byId.has(o.id)){sh.getRange(oldDate.row,1,1,h.length).setValues([h.map(k=>o[k]??'')]);updated++;return}}const vals=h.map(k=>o[k]??'');const old=byId.get(o.id);if(old){sh.getRange(old.row,1,1,h.length).setValues([vals]);updated++}else{sh.getRange(sh.getLastRow()+1,1,1,h.length).setValues([vals]);created++}});SpreadsheetApp.flush();result[tab]={received:incoming.length,created,updated,removed,stored:eventRead_(tab).length};log_('SYNC_'+tab,'received='+incoming.length+';created='+created+';updated='+updated+';removed='+removed)});return result}
function getEvents_(){return{ok:true,version:CONFIG.VERSION,DIEM_DANH:eventRead_('DIEM_DANH'),VI_PHAM:eventRead_('VI_PHAM'),KHEN_THUONG:eventRead_('KHEN_THUONG')}}
function doGet(e){const a=text_(e&&e.parameter&&e.parameter.action).toLowerCase()||'ping';try{if(a==='ping'){KHOI_TAO_CSDL();const boot=restoreMasterStudents_();return json_({ok:true,service:'LE_HOANG_CLASSROOM_SYNC',version:CONFIG.VERSION,spreadsheetId:CONFIG.SPREADSHEET_ID,students:boot.count,boot:boot},e)}if(a==='restore_master_students'||a==='repair_students'){KHOI_TAO_CSDL();return json_(restoreMasterStudents_(),e)}if(a==='get_students'||a==='getstudents'){KHOI_TAO_CSDL();let r=readStudents_();if(r.count===0){const boot=restoreMasterStudents_();r=boot.ok?readStudents_():r;r.bootstrap=boot}return json_(r,e)}if(a==='get_events'||a==='get_records')return json_(getEvents_(),e);if(a==='audit_duplicates'){const r=readStudents_();return json_({ok:true,physicalCount:r.physicalCount,logicalCount:r.logicalCount,duplicateCount:r.duplicateCount,duplicates:r.duplicates,policy:'READ_ONLY'},e)}return json_({ok:false,error:'Unknown action'},e)}catch(err){log_('ERROR',String(err.message||err));return json_({ok:false,error:String(err.message||err),version:CONFIG.VERSION},e)}}
function doPost(e){let body={};try{body=e&&e.postData&&e.postData.contents?JSON.parse(e.postData.contents):(e&&e.parameter&&e.parameter.payload?JSON.parse(e.parameter.payload):e&&e.parameter?e.parameter:{})}catch(err){return json_({ok:false,error:'Payload JSON không hợp lệ',version:CONFIG.VERSION},e)}const a=text_(body.action).toLowerCase();try{if(a==='sync_students')return json_(syncStudents_(body.students),e);if(a==='restore_master_students'||a==='repair_students'){KHOI_TAO_CSDL();return json_(restoreMasterStudents_(),e)}if(a==='sync_events'||a==='sync_records')return json_(syncEvents_(body),e);return json_({ok:false,error:'Unknown action'},e)}catch(err){log_('ERROR',String(err.message||err));return json_({ok:false,error:String(err.message||err),version:CONFIG.VERSION},e)}}
function KHOI_TAO_CSDL(){const ss=getSpreadsheet_();const defs={HOC_SINH:CONFIG.HEADERS.HOC_SINH,DIEM_DANH:CONFIG.HEADERS.DIEM_DANH,VI_PHAM:CONFIG.HEADERS.VI_PHAM,KHEN_THUONG:CONFIG.HEADERS.KHEN_THUONG,NHAT_KY:CONFIG.HEADERS.NHAT_KY};Object.keys(defs).forEach(function(name){let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);const h=defs[name];if(sh.getMaxColumns()<h.length)sh.insertColumnsAfter(sh.getMaxColumns(),h.length-sh.getMaxColumns());sh.getRange(1,1,1,h.length).setValues([h])});SpreadsheetApp.flush();const boot=restoreMasterStudents_();return{ok:true,spreadsheetId:ss.getId(),spreadsheetName:ss.getName(),tabs:Object.keys(defs),students:boot.count,bootstrap:boot}}
function BOOTSTRAP_CSDL_A_TO_Z(){return KHOI_TAO_CSDL()}
function testConnection(){const r=KHOI_TAO_CSDL();const ss=getSpreadsheet_();const result={ok:true,spreadsheetId:ss.getId(),spreadsheetName:ss.getName(),tabs:ss.getSheets().map(function(s){return s.getName()}),students:r.students,bootstrap:r.bootstrap};Logger.log(JSON.stringify(result));return result}
