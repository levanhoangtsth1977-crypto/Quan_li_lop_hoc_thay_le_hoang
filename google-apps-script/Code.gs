/** LE HOANG CLASSROOM SYNC — MASTER 3.2 SAFE UPSERT + MASTER ROSTER RECOVERY
 * HOC_SINH is permanently 12 columns. No studentCode in HOC_SINH.
 */
const CONFIG=Object.freeze({SPREADSHEET_ID:'174xQ29phs-Or7OOEKOM0IHylFJXg5SsqzOC27x7K3Wg',SCHOOL_YEAR:'2026–2027',CLASS_NAME:'5C',EXPECTED_STUDENTS:42,VERSION:'MASTER-3.2-SAFE-UPSERT-RECOVERY',ROSTER_URL:'https://raw.githubusercontent.com/levanhoangtsth1977-crypto/Quan_li_lop_hoc_thay_le_hoang/master/DANH_SACH_HOC_SINH_5C_2026_2027.json',HEADERS:{HOC_SINH:['id','name','gender','birthDate','status','parentName','phone','address','note','shareEnabled','createdAt','updatedAt'],NHAT_KY:['timestamp','action','sheet','recordId','message']}});
function getSpreadsheet_(){return SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID)}
function text_(v){return String(v==null?'':v).trim().replace(/\s+/g,' ')}
function key_(v){return text_(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLowerCase().replace(/[^a-z0-9]/g,'')}
function dateKey_(v){if(v instanceof Date&&!isNaN(v))return Utilities.formatDate(v,Session.getScriptTimeZone()||'Asia/Ho_Chi_Minh','ddMMyyyy');const s=text_(v),m=s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})/);return m?m[1].padStart(2,'0')+m[2].padStart(2,'0')+m[3]:s.replace(/\D/g,'')}
function identity_(s){return key_(s.name)+'|'+dateKey_(s.birthDate)+'|'+key_(s.gender)}
function json_(o,e){const cb=text_(e&&e.parameter&&e.parameter.callback),b=JSON.stringify(o);return cb&&/^[A-Za-z_$][\w$\.]*$/.test(cb)?ContentService.createTextOutput(cb+'('+b+');').setMimeType(ContentService.MimeType.JAVASCRIPT):ContentService.createTextOutput(b).setMimeType(ContentService.MimeType.JSON)}
function headerOk_(sh){const h=CONFIG.HEADERS.HOC_SINH;if(sh.getMaxColumns()<12)return false;const a=sh.getRange(1,1,1,12).getValues()[0].map(text_);return h.every((x,i)=>a[i]===x)}
function sheet_(){const sh=getSpreadsheet_().getSheetByName('HOC_SINH');if(!sh)throw Error('Không tìm thấy HOC_SINH.');if(!headerOk_(sh))throw Error('Header HOC_SINH không đúng 12 cột.');return sh}
function read_(){const sh=sheet_(),n=sh.getLastRow();if(n<2)return[];return sh.getRange(2,1,n-1,12).getValues().map((r,i)=>({id:text_(r[0]),name:text_(r[1]),gender:text_(r[2]),birthDate:r[3],status:text_(r[4])||'active',parentName:text_(r[5]),phone:text_(r[6]),address:text_(r[7]),note:text_(r[8]),shareEnabled:String(r[9]).toUpperCase()!=='FALSE',createdAt:r[10],updatedAt:r[11],row:i+2})).filter(s=>s.id&&s.name)}
function log_(a,m){try{const ss=getSpreadsheet_(),sh=ss.getSheetByName('NHAT_KY')||ss.insertSheet('NHAT_KY');if(sh.getLastRow()<1)sh.getRange(1,1,1,5).setValues([CONFIG.HEADERS.NHAT_KY]);sh.appendRow([new Date(),a,'HOC_SINH','',m])}catch(_) {}}
function normalize_(s,i){return{id:text_(s.id)||('STU_5C_2026_'+String(i+1).padStart(3,'0')),name:text_(s.name||s.studentName),gender:text_(s.gender),birthDate:s.birthDate||'',status:text_(s.status)||'active',parentName:text_(s.parentName),phone:text_(s.phone),address:text_(s.address),note:text_(s.note),shareEnabled:s.shareEnabled!==false,createdAt:s.createdAt||new Date(),updatedAt:new Date()}}
function dedupe_(a){const m=new Map();(a||[]).map((s,i)=>normalize_(s,i)).filter(s=>s.name).forEach(s=>{const k=identity_(s);if(!m.has(k))m.set(k,s)});return Array.from(m.values())}
function readStudents_(){const p=read_(),m=new Map(),dups=[];p.forEach(s=>{const k=identity_(s);if(!m.has(k))m.set(k,s);else dups.push({keptId:m.get(k).id,droppedId:s.id,name:s.name})});const students=Array.from(m.values()).sort((a,b)=>key_(a.name).localeCompare(key_(b.name),'vi'));return{ok:true,count:students.length,physicalCount:p.length,logicalCount:students.length,duplicateCount:dups.length,students,duplicates:dups,source:'HOC_SINH_SAFE_IDENTITY',version:CONFIG.VERSION}}
function restoreMasterStudents_(){const sh=sheet_();if(read_().length>0)return{ok:true,restored:false,count:read_().length,reason:'HOC_SINH_NOT_EMPTY'};const res=UrlFetchApp.fetch(CONFIG.ROSTER_URL,{muteHttpExceptions:true});if(res.getResponseCode()!==200)throw Error('Không đọc được danh sách MASTER trên GitHub.');const src=JSON.parse(res.getContentText());const students=dedupe_(src.students||[]);if(students.length!==CONFIG.EXPECTED_STUDENTS)throw Error('Danh sách MASTER không đủ 42 học sinh.');const rows=students.map(s=>[s.id,s.name,s.gender,s.birthDate,s.status,s.parentName,s.phone,s.address,s.note,s.shareEnabled,s.createdAt,s.updatedAt]);sh.getRange(2,1,rows.length,12).setValues(rows);SpreadsheetApp.flush();log_('MASTER_ROSTER_RECOVERY','Khôi phục 42 học sinh từ GitHub, không xóa/đổi schema');return{ok:true,restored:true,count:rows.length,physicalCount:read_().length,source:'GITHUB_MASTER_ROSTER',version:CONFIG.VERSION}}
function syncStudents_(incoming){if(!Array.isArray(incoming)||!incoming.length)throw Error('Không có dữ liệu học sinh.');const sh=sheet_(),physical=read_(),updated=[],created=[],seen=new Set();incoming.map((s,i)=>normalize_(s,i)).forEach(s=>{if(!s.name)return;const ik=identity_(s);let target=physical.find(x=>x.id===s.id)||physical.find(x=>identity_(x)===ik);if(target){s.id=target.id;const old=sh.getRange(target.row,1,1,12).getValues()[0];sh.getRange(target.row,1,1,12).setValues([[s.id,s.name,s.gender,s.birthDate,s.status||old[4]||'active',s.parentName||old[5],s.phone||old[6],s.address||old[7],s.note||old[8],s.shareEnabled,old[10]||s.createdAt,new Date()]]);updated.push(s.id)}else if(!seen.has(ik)){const row=sh.getLastRow()+1;sh.getRange(row,1,1,12).setValues([[s.id,s.name,s.gender,s.birthDate,s.status,s.parentName,s.phone,s.address,s.note,s.shareEnabled,s.createdAt,new Date()]]);physical.push(Object.assign({},s,{row}));created.push(s.id);seen.add(ik)}});SpreadsheetApp.flush();const r=readStudents_();log_('SAFE_UPSERT','created='+created.length+';updated='+updated.length+';physical='+r.physicalCount);return{ok:true,created:created.length,updated:updated.length,deleted:0,physicalCount:r.physicalCount,logicalCount:r.logicalCount,duplicateCount:r.duplicateCount,version:CONFIG.VERSION}}
function doGet(e){const a=text_(e&&e.parameter&&e.parameter.action).toLowerCase()||'ping';try{if(a==='ping')return json_({ok:true,service:'LE_HOANG_CLASSROOM_SYNC',version:CONFIG.VERSION},e);if(a==='restore_master_students'||a==='repair_students')return json_(restoreMasterStudents_(),e);if(a==='get_students'||a==='getstudents')return json_(readStudents_(),e);if(a==='audit_duplicates'){const r=readStudents_();return json_({ok:true,physicalCount:r.physicalCount,logicalCount:r.logicalCount,duplicateCount:r.duplicateCount,duplicates:r.duplicates,policy:'READ_ONLY'},e)}return json_({ok:false,error:'Unknown action'},e)}catch(err){log_('ERROR',String(err.message||err));return json_({ok:false,error:String(err.message||err),version:CONFIG.VERSION},e)}}
function doPost(e){const body=e&&e.postData&&e.postData.contents?JSON.parse(e.postData.contents):(e&&e.parameter&&e.parameter.payload?JSON.parse(e.parameter.payload):e.parameter||{});const a=text_(body.action).toLowerCase();try{if(a==='sync_students')return json_(syncStudents_(body.students),e);if(a==='restore_master_students'||a==='repair_students')return json_(restoreMasterStudents_(),e);return json_({ok:false,error:'Unknown action'},e)}catch(err){log_('ERROR',String(err.message||err));return json_({ok:false,error:String(err.message||err),version:CONFIG.VERSION},e)}}